# =============================================================================
#  RUNNER settings
#  `npm run setup` copies this file to .env.local and fills in the admin
#  password for you. Edit .env.local (never this file) and restart the app.
#  Nothing in here is a private key — RUNNER never needs one.
# =============================================================================

# --- Admin login -------------------------------------------------------------
ADMIN_USERNAME=admin
# 12+ characters (setup generates one)
ADMIN_PASSWORD=
# 32+ random characters used to sign the login cookie (setup generates one)
ADMIN_SESSION_SECRET=

# --- Solana network ----------------------------------------------------------
# mainnet-beta = real money. devnet = free practice network with test USDC.
SOLANA_CLUSTER=mainnet-beta
# Optional but strongly recommended: a dedicated RPC URL (free tiers at
# helius.dev, quicknode.com, triton.one). The public default is rate-limited
# and does not allow holder snapshots.
SOLANA_RPC_URL=

# --- Treasury (public address only) ------------------------------------------
# The wallet that receives fees, buys project tokens, and sends rewards.
# Use a hardware wallet or a Squads multisig. Its private key NEVER goes here:
# you approve each purchase/distribution in your wallet from the admin page.
TREASURY_WALLET=

# test = simulated payments (default). live = applicants pay real USDC to TREASURY_WALLET.
PAYMENTS_MODE=test
# test = simulated purchases/distributions. live = Jupiter buys + on-chain reward transfers.
TREASURY_MODE=test

# --- RUNNER token -------------------------------------------------------------
# Mint address of the RUNNER token once it exists. Enables live balances and snapshots.
RUNNER_MINT=
# Wallets to leave out of snapshots (LP pool, team, burn), comma-separated.
# The treasury is always excluded automatically.
RUNNER_EXCLUDED_WALLETS=

# --- Advanced (defaults are fine) ---------------------------------------------
# Where the database file lives. Back this file up!
RUNNER_DB_PATH=data/runner.db
# Load the fictional DEMO DATA into a brand-new database (true/false).
SEED_DEMO_DATA=true
SWAP_SLIPPAGE_BPS=100
DISTRIBUTION_BATCH_SIZE=5
# Jupiter swap API. The free lite endpoint needs no key; set JUPITER_API_KEY to use api.jup.ag.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
