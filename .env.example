# ---------------------------------------------------------------------------
# RUNNER environment variables
# Copy to .env.local and fill in. Never commit real values.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solana RPC used by the wallet adapter (read-only; defaults to public mainnet-beta)
NEXT_PUBLIC_SOLANA_RPC_URL=

# --- Supabase --------------------------------------------------------------
# Leave all three empty to run on the built-in in-memory DEMO DATA store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin (demo mode only, when Supabase is not configured) ---------------
# In Supabase mode, admins sign in with Supabase Auth and must have
# role = 'admin' in public.users (see README).
ADMIN_USERNAME=admin
# 12+ characters. Server-only.
ADMIN_PASSWORD=
# 32+ random characters used to sign the admin session cookie.
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=
